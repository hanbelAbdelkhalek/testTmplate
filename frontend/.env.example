# Frontend — copier en .env.local pour `npm run dev`.

# Adresse de Django vue par le serveur Next (jamais par le navigateur).
# En production : http://<PREFIX>-backend:8000/api, posé par docker-compose.yml.
DJANGO_API_URL=http://127.0.0.1:8000/api

# Figée au build (argument Docker). Nom affiché dans l'onglet.
NEXT_PUBLIC_APP_NAME=SigmaGravity
