# Variables d'une pile. Sur le serveur : .env.dev et .env.prod, à la racine
# du dépôt, jamais versionnés.
#
# Elles se saisissent dans la plateforme (Gestion des solutions → crayon →
# Variables d'environnement), qui rend le fichier :
#   docker exec nfc_dev_backend python manage.py ecrire_env <cle> > /tmp/env \
#     && install -m 600 /tmp/env .env.dev; rm -f /tmp/env

# --- Pile ---------------------------------------------------------------
# Préfixe des conteneurs, alias et volumes : <cle>-dev ou <cle>-prod.
# Doit valoir le « Projet Compose » de la solution dans la plateforme.
PREFIX=template-dev
ENVIRONMENT=dev
SOLUTION_KEY=template
SOLUTION_VERSION=0.1.0
APP_NAME=SigmaGravity Template

# --- Secrets --------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Base dédiée sur global_postgres : <cle>_dev / <cle>_prod.
DATABASE_URL=postgres://template_dev:MOT_DE_PASSE@global_postgres:5432/template_dev
# Le même secret que la plateforme utilise pour signer ses appels à cette
# solution (variable nommée dans le registre, champ « signing_secret_env »).
PLATFORM_SHARED_SECRET=
PLATFORM_KEY_ID=platform-v1
